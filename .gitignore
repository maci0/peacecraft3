# Ignore
/target
**/*.rs.bk
Cargo.lock.orig

# Reverse-engineering caches and vendored assets
/.rea
/rea/
/.tools/ghidra
/.tools/profiling/
/.tools/wasm-bindgen/

# The user's own game install and extracted assets.
# Nothing Blizzard ships belongs in this repository; we read the install at
# runtime from the path given by PCX_WC3_INSTALL.
/wc3
/wc3_extracted
/wc3/game
*.zip
*.iso
*.7z
*.mpq
*.w3m
*.w3n
*.w3u
*.w3t
*.w3a
*.w3d
*.w3b
*.w3h
*.w3q
*.w3s
*.w3r

# Editor / OS
.idea/
.vscode/
.DS_Store

# Python bytecode caches, from the probes under tools/.
__pycache__/
*.py[cod]

# Generated by `wasm-bindgen --target web --out-dir web/pkg …`, tens of MB.
/web/pkg

# Extracted from the local game install for the browser launcher.
/web/assets/

# Local probes, screenshots, and extracted runtime files.
/.scratch/
/dist/
*.exe
/crates/pcx-blp/tests/fixtures/
